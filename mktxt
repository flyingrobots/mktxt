#!/bin/bash

# Default values
CWD="."
FILTER="*"
OUTPUT_FILE="$(pwd)/mktxt_aggregate.txt"

# Simple argument parsing
for i in "$@"; do
  case $i in
    --cwd=*)
      CWD="${i#*=}"
      shift
      ;;
    filter=*)
      FILTER="${i#*=}"
      shift
      ;;
    *)
      # Unknown option
      ;;
  esac
done

if [ ! -d "$CWD" ]; then
  echo "Error: Directory '$CWD' does not exist." >&2
  exit 1
fi

# Get absolute path for the output file and related sidecars
OUTPUT_FILE_ABS=$(realpath "$OUTPUT_FILE" 2>/dev/null || echo "$OUTPUT_FILE")
PREV_FILE="${OUTPUT_FILE_ABS}.prev.txt"
DIFF_FILE="${OUTPUT_FILE_ABS}.prev.diff.txt"

# If the output file already exists, rotate it to .prev.txt
if [[ -f "$OUTPUT_FILE_ABS" ]]; then
    mv "$OUTPUT_FILE_ABS" "$PREV_FILE"
fi

# Clear or create the fresh output file
> "$OUTPUT_FILE_ABS"

# Track processed files by their canonical absolute path to avoid duplicates/cycles
VISITED_PATHS="|"

# Change to target directory
cd "$CWD" || exit 1

# Process files using NUL byte separation
process_files() {
    while IFS= read -r -d '' file; do
        ABS_FILE=$(realpath "$file" 2>/dev/null)
        
        if [[ $? -ne 0 || -z "$ABS_FILE" ]]; then
            continue
        fi

        # Skip the output file and its sidecars
        if [[ "$ABS_FILE" == "$OUTPUT_FILE_ABS" || "$ABS_FILE" == "$PREV_FILE" || "$ABS_FILE" == "$DIFF_FILE" ]]; then
            continue
        fi

        if [[ "$VISITED_PATHS" == *"|$ABS_FILE|"* ]]; then
            continue
        fi
        VISITED_PATHS="${VISITED_PATHS}${ABS_FILE}|"

        if [[ -f "$file" ]] && grep -qI . "$file" 2>/dev/null; then
            LINE_COUNT=$(grep -c '^' "$file")
            SIZE=$(wc -c < "$file" | tr -d ' ')
            
            ESCAPED_PATH=$(echo "$file" | sed 's/\\/\\\\/g; s/"/\\"/g')
            printf '{"path":"%s","lines":%d,"size":%d}\n' "$ESCAPED_PATH" "$LINE_COUNT" "$SIZE"
            
            echo "# $file" >> "$OUTPUT_FILE_ABS"
            cat "$file" >> "$OUTPUT_FILE_ABS"
            echo -e "\n" >> "$OUTPUT_FILE_ABS"
        fi
    done
}

# Get the list of files to process
if git rev-parse --is-inside-work-tree > /dev/null 2>&1; then
    git ls-files -z "$FILTER" | process_files
else
    find . -type f -name "$FILTER" -not -path '*/.*' -print0 | process_files
fi

# Final Summary for the output file
if [[ -f "$OUTPUT_FILE_ABS" ]]; then
    FINAL_LINES=$(grep -c '^' "$OUTPUT_FILE_ABS")
    FINAL_SIZE=$(wc -c < "$OUTPUT_FILE_ABS" | tr -d ' ')
    ESCAPED_OUT=$(echo "$OUTPUT_FILE_ABS" | sed 's/\\/\\\\/g; s/"/\\"/g')
    printf '{"path":"%s","lines":%d,"size":%d}\n' "$ESCAPED_OUT" "$FINAL_LINES" "$FINAL_SIZE"
fi

# Generate diff if a previous file exists
if [[ -f "$PREV_FILE" ]]; then
    # Use unified diff; || true because diff returns 1 if files differ
    diff -u "$PREV_FILE" "$OUTPUT_FILE_ABS" > "$DIFF_FILE" || true
    
    DIFF_LINES=$(grep -c '^' "$DIFF_FILE")
    DIFF_SIZE=$(wc -c < "$DIFF_FILE" | tr -d ' ')
    ESCAPED_DIFF=$(echo "$DIFF_FILE" | sed 's/\\/\\\\/g; s/"/\\"/g')
    printf '{"path":"%s","lines":%d,"size":%d}\n' "$ESCAPED_DIFF" "$DIFF_LINES" "$DIFF_SIZE"
fi
