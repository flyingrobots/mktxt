#!/bin/bash

# Default values
CWD="."
FILTER="*"
OUTPUT_FILE="$(pwd)/mktxt_aggregate.txt"

# Simple argument parsing
for i in "$@"; do
  case $i in
    --cwd=*)
      CWD="${i#*=}"
      shift
      ;;
    filter=*)
      FILTER="${i#*=}"
      shift
      ;;
    *)
      # Unknown option
      ;;
  esac
done

# Resolve absolute path for CWD to ensure we can switch back if needed, 
# or just run commands within it.
if [ ! -d "$CWD" ]; then
  echo "Error: Directory '$CWD' does not exist."
  exit 1
fi

# Clear or create the output file in the original working directory
> "$OUTPUT_FILE"

# Change to target directory
cd "$CWD" || exit 1

# Get the list of files to process
if git rev-parse --is-inside-work-tree > /dev/null 2>&1; then
    # Use git ls-files with pattern if provided
    # Note: git ls-files takes patterns directly
    FILES=$(git ls-files "$FILTER")
else
    # Fallback to find if not in a git repo
    # Using -name for the filter
    FILES=$(find . -type f -name "$FILTER" -not -path '*/.*')
fi

# Iterate over each file and append content if it's not binary
for file in $FILES; do
    # Skip the output file itself if it happens to be in the same dir
    ABS_FILE=$(realpath "$file")
    if [[ "$ABS_FILE" == "$OUTPUT_FILE" ]]; then
        continue
    fi

    # Check if the file is a regular file and not binary
    if [[ -f "$file" ]] && grep -qI . "$file"; then
        echo "# $file" >> "$OUTPUT_FILE"
        cat "$file" >> "$OUTPUT_FILE"
        # Ensure there's at least one newline after each file's content
        echo -e "\n" >> "$OUTPUT_FILE"
    fi
done

echo "Aggregated files from '$CWD' matching '$FILTER' into: $OUTPUT_FILE"
