{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mktxt.local/schemas/feedback-item-1.0.0.json",
  "title": "mktxt design-feedback item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "area",
    "state",
    "provenance",
    "feedback",
    "repository_context",
    "proposal",
    "evaluation"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "area": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lifecycle", "decision", "implementation"],
      "properties": {
        "lifecycle": {
          "enum": ["proposed", "adjudicated", "superseded"]
        },
        "decision": {
          "enum": ["pending", "accepted", "rejected", "deferred", "superseded"]
        },
        "implementation": {
          "enum": ["not-started", "planned", "in-progress", "complete", "not-applicable"]
        },
        "decided_on": {
          "type": "string",
          "format": "date"
        },
        "decided_by": {
          "type": "string",
          "minLength": 1
        },
        "decision_rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type",
        "source_name",
        "source_model_version",
        "relayed_by",
        "received_on",
        "source_label",
        "review_target"
      ],
      "properties": {
        "source_type": {
          "const": "external-model-feedback"
        },
        "source_name": {
          "type": "string",
          "minLength": 1
        },
        "source_model_version": {
          "type": "string",
          "minLength": 1
        },
        "relayed_by": {
          "type": "string",
          "minLength": 1
        },
        "received_on": {
          "type": "string",
          "format": "date"
        },
        "source_label": {
          "type": "string",
          "minLength": 1
        },
        "review_target": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verbatim", "normalized_claim"],
      "properties": {
        "verbatim": {
          "type": "string",
          "minLength": 1
        },
        "normalized_claim": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "repository_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_version", "current_behavior", "evidence"],
      "properties": {
        "observed_version": {
          "type": "string",
          "minLength": 1
        },
        "current_behavior": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "candidate_changes", "non_goals"],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "candidate_changes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "non_goals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questions", "risks", "evidence_needed", "decision_dependencies"],
      "properties": {
        "questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_needed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "decision_dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "related_items": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
