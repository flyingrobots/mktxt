{
  "name": "mktxtx",
  "version": "5.0.0",
  "description": "TypeScript rewrite of mktxt using Graft",
  "author": "James Ross <james@flyingrobots.dev>",
  "keywords": [
    "mktxt",
    "mktxtx",
    "aggregate",
    "context",
    "ast",
    "graft"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "exports": "./dist/index.js",
  "engines": {
    "node": ">=20.11.0"
  },
  "files": [
    "bin/",
    "dist/",
    "docs/",
    "README.md"
  ],
  "bin": {
    "mktxt": "./bin/mktxt.js",
    "mktxtx": "./bin/mktxt.js"
  },
  "scripts": {
    "build": "tsc",
    "check:explainer": "pnpm run build && node scripts/verify-explainer.mjs",
    "generate:fixtures": "tsx scripts/generate-context-sample.ts",
    "check:fixtures": "tsx scripts/generate-context-sample.ts --check",
    "test": "pnpm run check:fixtures && pnpm run check:explainer && node --import tsx --test src/*.test.ts",
    "test:install": "bash scripts/test-install.sh",
    "start": "tsx src/index.ts",
    "mktxtx": "tsx src/index.ts"
  },
  "dependencies": {
    "@flyingrobots/graft": "0.11.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
